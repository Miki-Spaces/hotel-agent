# ==============================================================================
# Supabase Configuration
# ==============================================================================
# Replace these with your real Supabase project URL and keys from:
# https://supabase.com/dashboard/project/<your-project-id>/settings/api
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# JWT Secret from Supabase (Settings -> API -> JWT Secret)
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# Server Port & Host
HOST=0.0.0.0
PORT=8000

# Voice Bot Webhook Secret API Key (Optional protection for Botnoi Webhook)
VOICE_BOT_API_KEY=botnoi-hotel-agent-secret-key-2026
